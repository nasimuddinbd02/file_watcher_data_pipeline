WATCH_DIR=./watch
DB_FILE_PATH=./data/appointments.db
ALLOWED_EXTENSION=.json
POLL_INTERVAL_MS=5000

# Security
NODE_ENV=development
# Comma-separated allowed origins for CORS.
CORS_ORIGINS=

# JWT Authentication
JWT_SECRET=change_me_in_production_use_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=1d
